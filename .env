# RocketRide development connection (managed): use for running, validating, and iterating - use(), send/chat, monitors, the app dev loop.
ROCKETRIDE_URI=http://localhost:63967
ROCKETRIDE_APIKEY=MYAPIKEY
# RocketRide deployment target (managed): use for deploy.*, schedules, publishApp/submitApp, build logs. If these lines are absent, no deploy target is configured - ask the user; never deploy to the dev connection.
ROCKETRIDE_DEPLOY_URI=http://localhost:63967
ROCKETRIDE_DEPLOY_APIKEY=MYAPIKEY
